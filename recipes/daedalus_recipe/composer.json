{
    "name": "drupal/daedalus_recipe",
    "description": "Installs and configures the Daedalus page builder: the base site recipe at the root, the AI editing assistant site recipe in ai/, and every ingredient under ingredients/.",
    "homepage": "https://www.drupal.org/project/daedalus_recipe",
    "type": "drupal-recipe",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Tim Bozeman",
            "homepage": "https://bozeman.engineering",
            "role": "Maintainer"
        },
        {
            "name": "Lillian Bozeman",
            "homepage": "https://bozeman.engineering",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://www.drupal.org/project/issues/daedalus_recipe",
        "source": "https://git.drupalcode.org/project/daedalus_recipe"
    },
    "require": {
        "drupal/core": ">=11.3 <11.5",
        "drupal/daedalus": "^1.0",
        "drupal/daedalus_theme": "^1.0",
        "drupal/field_sample_value": "^1.0",
        "drupal/twig_events": "^1.0",
        "drupal/layout_builder_restrictions": "^3.0",
        "drupal/svg_image_field": "^2.3",
        "drupal/ai": "^1.4",
        "drupal/ai_agents": "^1.3",
        "drupal/ai_provider_anthropic": "^1.3@beta",
